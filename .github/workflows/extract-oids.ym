name: Extract All Certificates

on:
  push:
    branches: [ main, master ]
    paths:
      - 'com.apple.tips.txt'
      - '.github/workflows/extract-oids.yml'
  workflow_dispatch:

jobs:
  extract-all:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Install openssl
        run: sudo apt-get update && sudo apt-get install -y openssl

      - name: Extract all certificates
        run: |
          python3 << 'EOF'
          import base64, subprocess, tempfile, os

          with open('com.apple.tips.txt', 'rb') as f:
              data = f.read()

          # 解析所有证书
          certs = []
          pos = 0
          while True:
              start = data.find(b'\x30\x82', pos)
              if start == -1:
                  break
              if start + 4 > len(data):
                  break
              cert_len = (data[start+2] << 8) | data[start+3]
              total_len = cert_len + 4
              if start + total_len > len(data):
                  break
              certs.append(data[start:start+total_len])
              pos = start + total_len

          print(f"✅ 找到 {len(certs)} 个证书")
          
          if len(certs) == 0:
              print("❌ 未找到证书")
              exit(1)

          # 保存所有证书
          all_pems = []
          for i, cert_data in enumerate(certs):
              # 保存 DER
              with open(f'cert_{i+1}.der', 'wb') as f:
                  f.write(cert_data)
              
              # 转换为 PEM
              b64 = base64.b64encode(cert_data).decode()
              pem = '-----BEGIN CERTIFICATE-----\n'
              pem += '\n'.join(b64[j:j+64] for j in range(0, len(b64), 64))
              pem += '\n-----END CERTIFICATE-----\n'
              
              with open(f'cert_{i+1}.pem', 'w') as f:
                  f.write(pem)
              
              all_pems.append(pem)
              print(f"  证书 #{i+1}: {len(cert_data)} 字节")

          # 生成汇总信息
          with open('certificates-info.txt', 'w', encoding='utf-8') as txt:
              txt.write("=" * 70 + "\n")
              txt.write(f"📜 共提取 {len(certs)} 个证书\n")
              txt.write("=" * 70 + "\n\n")
              
              for i, cert_data in enumerate(certs):
                  with tempfile.NamedTemporaryFile(mode='wb', suffix='.der', delete=False) as tmp:
                      tmp.write(cert_data)
                      tmp_path = tmp.name
                  
                  txt.write(f"\n{'='*70}\n")
                  txt.write(f"📄 证书 #{i+1}\n")
                  txt.write(f"{'='*70}\n\n")
                  
                  # 基本信息
                  result = subprocess.run(
                      f'openssl x509 -in {tmp_path} -inform DER -noout -subject -issuer -dates -fingerprint -sha256 2>/dev/null',
                      shell=True, capture_output=True, text=True
                  )
                  txt.write(result.stdout + "\n")
                  
                  # OID 列表
                  txt.write("📌 OID 列表:\n")
                  result2 = subprocess.run(
                      f'openssl x509 -in {tmp_path} -inform DER -text -noout 2>/dev/null | grep -E "([0-9]+\\.)+[0-9]+"',
                      shell=True, capture_output=True, text=True
                  )
                  for line in result2.stdout.split('\n'):
                      if line.strip():
                          txt.write(f"  {line.strip()}\n")
                  
                  # 查找 Team ID OID（检查每个证书）
                  result3 = subprocess.run(
                      f'openssl asn1parse -inform DER -in {tmp_path} 2>/dev/null | grep -A 10 "1.2.840.113635.100.6.1.15"',
                      shell=True, capture_output=True, text=True
                  )
                  if result3.stdout:
                      txt.write("\n🔑 Team ID OID (1.2.840.113635.100.6.1.15) 详情:\n")
                      txt.write(result3.stdout + "\n")
                  
                  # PEM 内容
                  txt.write(f"\n📄 PEM 格式:\n")
                  txt.write(all_pems[i])
                  txt.write("\n")
                  
                  os.unlink(tmp_path)
              
              txt.write("\n" + "=" * 70 + "\n")
              txt.write("✅ 提取完成\n")
              txt.write("=" * 70 + "\n")

          print("\n✅ 已保存 certificates-info.txt")
          for i in range(len(certs)):
              print(f"✅ cert_{i+1}.pem 和 cert_{i+1}.der")
          EOF

      - name: Upload artifacts
        uses: actions/upload-artifact@v4
        with:
          name: all-certificates
          path: |
            cert_*.pem
            cert_*.der
            certificates-info.txt

      - name: Save to workflow summary
        run: |
          if [ -f certificates-info.txt ]; then
            echo "### 📜 证书提取结果" >> $GITHUB_STEP_SUMMARY
            echo '```' >> $GITHUB_STEP_SUMMARY
            head -200 certificates-info.txt >> $GITHUB_STEP_SUMMARY
            echo '...' >> $GITHUB_STEP_SUMMARY
            echo '```' >> $GITHUB_STEP_SUMMARY
          fi
